# Forte Research — matplotlib house style.
# Colours synced from forte-palette.json (chart_cycle).

font.family:           sans-serif
font.sans-serif:       Inter, "Source Sans Pro", "Helvetica Neue", Arial, sans-serif
font.size:             11

axes.titlesize:        14
axes.titleweight:      bold
axes.titlelocation:    left
axes.titlecolor:       "#1F1B4D"
axes.titlepad:         12

axes.labelsize:        10
axes.labelcolor:       "#1A1A1A"
axes.edgecolor:        "#1A1A1A"
axes.linewidth:        0.8
axes.spines.top:       False
axes.spines.right:     False
axes.facecolor:        "#FFFFFF"
axes.grid:             True
axes.grid.axis:        x
axes.axisbelow:        True

axes.prop_cycle:       cycler('color', ['1F1B4D', '5BC0BE', '302070', '5A8DA6', '82DDD9', '3DA8A6'])

grid.color:            "#E8E8EE"
grid.linestyle:        --
grid.linewidth:        0.6

xtick.color:           "#1A1A1A"
xtick.labelsize:       9
xtick.direction:       out
xtick.major.size:      4

ytick.color:           "#1A1A1A"
ytick.labelsize:       9
ytick.direction:       out
ytick.major.size:      0

legend.frameon:        False
legend.fontsize:       9
legend.loc:            best

figure.figsize:        10, 5.5
figure.dpi:            200
figure.facecolor:      "#FFFFFF"
figure.autolayout:     False
savefig.dpi:           200
savefig.bbox:          tight
savefig.facecolor:     "#FFFFFF"

lines.linewidth:       2.0
lines.solid_capstyle:  round
